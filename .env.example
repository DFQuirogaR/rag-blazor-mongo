# ==========================================
# Variables de Entorno - RAG Blazor App
# ==========================================
# Copiar este archivo a .env y personalizar para tu entorno
# ==========================================

# ------------------------------------------
# MongoDB Configuration
# ------------------------------------------
# Cadena de conexión a MongoDB
# Formato: mongodb://[user:password@]host:port/database
# Para contenedores: mongodb://mongodb:27017/RagDatabase
# Para local: mongodb://localhost:27017/RagDatabase
MONGO_CONNECTION_STRING=mongodb://mongodb:27017/RagDatabase

# Nombre de la base de datos
MONGO_DATABASE=RagDatabase

# ------------------------------------------
# Ollama Configuration
# ------------------------------------------
# URL del servidor Ollama
# Para contenedores: http://ollama:11434
# Para local: http://localhost:11434
OLLAMA_ENDPOINT=http://ollama:11434

# Modelo LLM principal para generación de respuestas
OLLAMA_MODEL=llama3.2

# Modelo para generación de embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Timeout para peticiones a Ollama (segundos)
OLLAMA_TIMEOUT=120

# ------------------------------------------
# Document Processing Configuration
# ------------------------------------------
# Carpeta del host que se monta en /app/documents.
# Por defecto se usa ./documents dentro del repositorio.
# En Windows puede ser, por ejemplo:
# DOCUMENTS_PATH=C:/Users/<usuario>/Documents/sharepoint_doc
DOCUMENTS_PATH=./documents

# Rutas de escaneo dentro del contenedor (separadas por |)
DOCUMENT_SCAN_PATHS=/app/documents|/app/documents/manuals|/app/documents/policies

# Intervalo de escaneo en minutos (0 para deshabilitar escaneo periódico)
DOCUMENT_SCAN_INTERVAL_MINUTES=5

# Patrones de exclusión (separados por |)
# Archivos que coincidan con estos patrones no serán procesados
DOCUMENT_EXCLUDE_PATTERNS=*.tmp|*.bak|*.temp|backup|temp

# Tamaño de chunk en caracteres (recomendado: 1000-2000)
DOCUMENT_CHUNK_SIZE=1500

# Sesgo entre chunks en caracteres (recomendado: 100-200)
DOCUMENT_CHUNK_OVERLAP=200

# Habilitar FileSystemWatcher para detección de cambios en tiempo real
DOCUMENT_ENABLE_FILESYSTEM_WATCHER=true

# ------------------------------------------
# Application Configuration
# ------------------------------------------
# Entorno: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# URLs de escucha (debe coincidir con el puerto expondo en Dockerfile)
ASPNETCORE_URLS=http://+:8080

# Nombre del host (para reverse proxy)
HOST_NAME=localhost

# Puerto del host
HOST_PORT=8080

# ------------------------------------------
# Logging Configuration
# ------------------------------------------
# Nivel de logging: Debug, Information, Warning, Error, Critical
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_APPLICATION=Information

# Ruta de logs dentro del contenedor
LOG_PATH=/app/logs/rag-blazor-.log

# Día de retención de logs
LOG_RETENTION_DAYS=30

# ------------------------------------------
# Security Configuration
# ------------------------------------------
# Habilitar validación de rutas de documentos
SECURITY_ENABLE_PATH_VALIDATION=true

# Permitir acceso a rutas relativas (solo para desarrollo)
SECURITY_ALLOW_RELATIVE_PATHS=false

# Timeout de autenticación (minutos) - si se implementa
AUTHENTICATION_TIMEOUT=30

# ------------------------------------------
# Backup Configuration
# ------------------------------------------
# Frecuencia de backup en formato cron
# @daily = cada día a medianoche
# @weekly = cada semana
# @monthly = cada mes
BACKUP_SCHEDULE=@daily

# Ruta de backup dentro del contenedor
BACKUP_PATH=/backups

# Retención de backup (número de backups a mantener)
BACKUP_RETENTION_COUNT=7

# ------------------------------------------
# Vector Search Configuration
# ------------------------------------------
# Número de resultados a recuperar en búsqueda vectorial
VECTOR_SEARCH_TOP_K=5

# Umbral de similitud (0-1, recomendado: 0.5-0.8)
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.5

# Habilitar reranking de resultados
VECTOR_ENABLE_RERANKING=true

# ------------------------------------------
# Cache Configuration
# ------------------------------------------
# Habilitar cache de embeddings
CACHE_ENABLE_EMBEDDING=true

# Tiempo de expiración de cache (segundos)
CACHE_EXPIRATION_SECONDS=3600

# Tamaño máximo de cache (número de entries)
CACHE_MAX_SIZE=10000

# ==========================================
# End of Environment Variables
# ==========================================