## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# Build results
[ Dd ]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[bB]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vscode/

# MSTest test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit test results
[TestResult.xml]
[Test-Results*/

# Visual C# cache files
iisexpress/
pubxml/
*.cache

# Node.js
node_modules/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/
*.nuget.props
*.nuget.targets
project.lock.json
project.assets.json

# Docker
*.env

# Logs
*.log

# Backups locales
backups/