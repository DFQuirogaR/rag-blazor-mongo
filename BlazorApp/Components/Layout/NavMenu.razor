<div class="sidebar-container @(Collapsed ? "collapsed" : "")">
    <nav class="nav flex-column" aria-label="Navegación principal">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Inicio">
                <i class="bi bi-house-door-fill"></i>
                @if (!Collapsed)
                {
                    <span>Inicio</span>
                }
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="chat" title="Chat">
                <i class="bi bi-chat-dots-fill"></i>
                @if (!Collapsed)
                {
                    <span>Chat</span>
                }
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="documents" title="Documentos">
                <i class="bi bi-folder-fill"></i>
                @if (!Collapsed)
                {
                    <span>Documentos</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }
}
