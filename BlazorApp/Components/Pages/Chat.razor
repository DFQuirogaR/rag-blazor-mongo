@page "/chat"
@rendermode InteractiveServer
@attribute [Authorize(Policy = ApplicationPolicies.ChatUse)]
@using BlazorApp.Models
@using BlazorApp.Services
@inject HistoryService HistoryService
@inject ILogger<Chat> Logger

<PageTitle>Consulta - Asistente RAG</PageTitle>

<div class="query-page">
    <section class="query-intro">
        <span class="query-eyebrow"><i class="bi bi-stars"></i> Asistente de conocimiento</span>
        <h1>¿Qué necesitas encontrar?</h1>
        <p>Escribe una consulta y obtén una respuesta basada en la documentación oficial.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <section class="query-form" aria-label="Nueva consulta">
        <div class="query-input-row">
            <i class="bi bi-search" aria-hidden="true"></i>
            <textarea class="message-input"
                      @bind="currentMessage"
                      @bind:event="oninput"
                      @onkeyup="HandleKeyUp"
                      disabled="@isLoading"
                      rows="1"
                      maxlength="2000"
                      placeholder="Escribe tu pregunta aquí..."></textarea>
            <button type="button" class="btn-send"
                    @onclick="SendMessage"
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))">
                @if (isLoading)
                {
                    <span class="query-spinner" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-arrow-up"></i>
                }
                <span>Consultar</span>
            </button>
        </div>
        <div class="query-form-footer">
            <span><i class="bi bi-lightbulb"></i> Presiona Enter para consultar.</span>
            <span class="char-count">@currentMessage.Length / 2000</span>
        </div>
    </section>

    <section class="answer-section" aria-live="polite">
        <div class="answer-heading">
            <div>
                <span class="query-eyebrow answer-eyebrow"><i class="bi bi-chat-square-text"></i> Resultado</span>
                <h2>Respuesta de la documentación</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(currentResponse))
            {
                <button type="button" class="clear-answer" @onclick="ClearAnswer" title="Limpiar respuesta">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Nueva consulta</span>
                </button>
            }
        </div>

        @if (isLoading)
        {
            <div class="answer-card answer-loading">
                <div class="answer-loading-icon"><span class="query-spinner"></span></div>
                <p>Consultando la documentación...</p>
                <span>Estamos preparando una respuesta basada en las fuentes disponibles.</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(currentResponse))
        {
            <div class="answer-card answer-sweep">
                <div class="answer-card-header">
                    <div class="answer-status"><i class="bi bi-check-circle-fill"></i> Respuesta encontrada</div>
                    @if (!string.IsNullOrWhiteSpace(submittedQuery))
                    {
                        <span class="answered-query">Consulta: @submittedQuery</span>
                    }
                </div>
                <div class="answer-content">
                    <MarkdownRenderer Content="@currentResponse" ShowActions="true" />
                </div>

                @if (sources.Count > 0)
                {
                    <div class="answer-sources">
                        <h3><i class="bi bi-journal-text"></i> Documentos consultados</h3>
                        <ul>
                            @foreach (var source in sources)
                            {
                                <li>
                                    <strong>@source.StoredDocumentName</strong>
                                    @if (source.Page.HasValue) { <span> · página @source.Page</span> }
                                    @if (!string.IsNullOrWhiteSpace(source.Section)) { <span> · @source.Section</span> }
                                    @if (source.Relevance.HasValue) { <small> · relevancia @source.Relevance.Value.ToString("P0")</small> }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="answer-card answer-empty">
                <div class="answer-empty-icon"><i class="bi bi-chat-square-text"></i></div>
                <h3>Tu respuesta aparecerá aquí</h3>
                <p>Realiza una consulta para obtener información relevante de los documentos procesados.</p>
            </div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sessionId")]
    public string? SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "query")]
    public string? InitialQuery { get; set; }

    private string currentMessage = string.Empty;
    private string? currentResponse;
    private string? submittedQuery;
    private string sessionTitle = "Nueva sesión";
    private bool isLoading;
    private bool initialQueryLoaded;
    private string? loadedSessionId;
    private string? errorMessage;
    private List<SourceReference> sources = new();

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId != loadedSessionId)
        {
            loadedSessionId = SessionId;
            await LoadLatestEntryAsync();
        }

        if (!initialQueryLoaded && !string.IsNullOrWhiteSpace(InitialQuery))
        {
            initialQueryLoaded = true;
            currentMessage = InitialQuery.Trim();
            errorMessage = null;
        }
    }

    private async Task LoadLatestEntryAsync()
    {
        currentResponse = null;
        submittedQuery = null;
        sources = new();
        if (string.IsNullOrWhiteSpace(SessionId)) return;

        var session = await HistoryService.GetSessionAsync(SessionId);
        if (session is null) return;

        sessionTitle = session.Title;
        var messages = session.Messages.OrderBy(message => message.Timestamp).ToList();
        var assistant = messages.LastOrDefault(message => message.Role == "assistant");
        var user = assistant is null
            ? messages.LastOrDefault(message => message.Role == "user")
            : messages.LastOrDefault(message => message.Role == "user" && message.Timestamp <= assistant.Timestamp);

        if (assistant is not null && assistant.IsReusable)
        {
            submittedQuery = user?.Content;
            currentResponse = assistant.Content;
            sources = assistant.Sources.ToList();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading) return;
        var query = currentMessage.Trim();
        currentMessage = string.Empty;
        errorMessage = null;
        isLoading = true;

        try
        {
            var result = await HistoryService.SubmitAsync(query, SessionId);
            SessionId = result.SessionId;
            loadedSessionId = result.SessionId;
            sessionTitle = query.Length > 80 ? query[..80] : query;
            submittedQuery = result.Query;
            currentResponse = result.Response;
            sources = result.RagResponse.Sources.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar la consulta en el historial");
            errorMessage = ex.Message;
            currentMessage = query;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs args)
    {
        if ((args.Key == "Enter" || args.Code == "Enter") && !args.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void ClearAnswer()
    {
        currentResponse = null;
        submittedQuery = null;
        sources = new();
        currentMessage = string.Empty;
        errorMessage = null;
    }
}
