@page "/chat"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using BlazorApp.Services
@using BlazorApp.Components
@inject RagService RagService
@inject ILogger<Chat> Logger

<PageTitle>Consulta - Asistente RAG</PageTitle>

<div class="query-page">
    <section class="query-intro">
        <span class="query-eyebrow"><i class="bi bi-stars"></i> Asistente de conocimiento</span>
        <h1>¿Qué necesitas encontrar?</h1>
        <p>Escribe una consulta y obtén una respuesta basada en la documentación oficial.</p>
    </section>

    <section class="query-form" aria-label="Nueva consulta">
        <div class="query-input-row">
            <i class="bi bi-search" aria-hidden="true"></i>
            <textarea class="message-input"
                      @bind="currentMessage"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      disabled="@isLoading"
                      rows="1"
                      maxlength="2000"
                      placeholder="Escribe tu pregunta aquí..."></textarea>
            <button class="btn-send"
                    @onclick="SendMessage"
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))">
                @if (isLoading)
                {
                    <span class="query-spinner" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-arrow-up"></i>
                }
                <span>Consultar</span>
            </button>
        </div>
        <div class="query-form-footer">
            <span><i class="bi bi-lightbulb"></i> Presiona Enter para consultar. Usa Shift+Enter para una nueva línea.</span>
            <span class="char-count">@currentMessage.Length / 2000</span>
        </div>
    </section>

    <section class="answer-section" aria-live="polite">
        <div class="answer-heading">
            <div>
                <span class="query-eyebrow answer-eyebrow"><i class="bi bi-chat-square-text"></i> Resultado</span>
                <h2>Respuesta de la documentación</h2>
            </div>
            @if (!string.IsNullOrWhiteSpace(currentResponse))
            {
                <button class="clear-answer" @onclick="ClearAnswer" title="Limpiar respuesta">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Nueva consulta</span>
                </button>
            }
        </div>

        @if (isLoading)
        {
            <div class="answer-card answer-loading">
                <div class="answer-loading-icon"><span class="query-spinner"></span></div>
                <p>Consultando la documentación...</p>
                <span>Estamos preparando una respuesta basada en las fuentes disponibles.</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(currentResponse))
        {
            <div class="answer-card answer-sweep" @key="responseVersion">
                <div class="answer-card-header">
                    <div class="answer-status"><i class="bi bi-check-circle-fill"></i> Respuesta encontrada</div>
                    @if (!string.IsNullOrWhiteSpace(submittedQuery))
                    {
                        <span class="answered-query">Consulta: @submittedQuery</span>
                    }
                </div>
                <div class="answer-content">
                    <MarkdownRenderer Content="@currentResponse" ShowActions="true" />
                </div>
            </div>
        }
        else
        {
            <div class="answer-card answer-empty">
                <div class="answer-empty-icon"><i class="bi bi-chat-square-text"></i></div>
                <h3>Tu respuesta aparecerá aquí</h3>
                <p>Realiza una consulta para obtener información relevante de los documentos procesados.</p>
            </div>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "query")]
    public string? InitialQuery { get; set; }

    private string currentMessage = string.Empty;
    private string? currentResponse;
    private string? submittedQuery;
    private bool isLoading;
    private int responseVersion;
    private bool initialQuerySent;

    protected override async Task OnParametersSetAsync()
    {
        if (!initialQuerySent && !string.IsNullOrWhiteSpace(InitialQuery))
        {
            initialQuerySent = true;
            currentMessage = InitialQuery;
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading)
        {
            return;
        }

        var userMessage = currentMessage.Trim();
        currentMessage = string.Empty;
        submittedQuery = userMessage;
        currentResponse = null;
        responseVersion++;
        isLoading = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("Calling RAG service with query: {Query}", userMessage);
            currentResponse = await RagService.QueryAsync(userMessage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calling RAG service");
            currentResponse = GetErrorMessage(ex);
        }
        finally
        {
            isLoading = false;
            responseVersion++;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if ((args.Key == "Enter" || args.Code == "Enter") && !args.ShiftKey)
        {
            await SendMessage();
        }
    }

    private void ClearAnswer()
    {
        currentResponse = null;
        submittedQuery = null;
        currentMessage = string.Empty;
        responseVersion++;
    }

    private static string GetErrorMessage(Exception ex)
    {
        if (ex.Message.Contains("404", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("Not Found", StringComparison.OrdinalIgnoreCase))
        {
            return "⏳ El servicio de IA está iniciando. Por favor espera unos minutos y vuelve a intentar.";
        }

        if (ex.Message.Contains("Connection refused", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("No connection", StringComparison.OrdinalIgnoreCase))
        {
            return "🔌 No se puede conectar al servicio de IA. Verifica que Ollama esté corriendo.";
        }

        return $"❌ Error al procesar la consulta: {ex.Message}";
    }
}
