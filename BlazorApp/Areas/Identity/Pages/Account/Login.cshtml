@page
@model BlazorApp.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var appName = "Nombre de la aplicación";
    var appSubtitle = "Portal de conocimiento operacional";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - @appName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-card" aria-labelledby="login-title">
            <div class="login-brand">
                <div class="login-logo" aria-label="Logo pendiente">
                    <i class="bi bi-robot" aria-hidden="true"></i>
                </div>
                <h1 id="login-title">@appName</h1>
                <p>@appSubtitle</p>
            </div>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="login-form">
                <div asp-validation-summary="ModelOnly" class="login-error" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Input.Email">Correo electrónico</label>
                    <input asp-for="Input.Email"
                           autocomplete="username"
                           autofocus
                           placeholder="nombre@empresa.com" />
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password">Contraseña</label>
                    <input asp-for="Input.Password"
                           autocomplete="current-password"
                           placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>

                <button type="submit" class="login-submit">Iniciar sesión</button>
            </form>

            <div class="login-footer">
                <span>Acceso local de desarrollo</span>
            </div>
        </section>
    </main>
</body>
</html>
