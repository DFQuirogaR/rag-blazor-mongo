{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BlazorApp.Services": "Information",
      "BlazorApp.Middleware": "Information",
      "BlazorApp.Logging": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rag-blazor-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProperty" ],
    "Properties": {
      "Application": "RAG-Blazor"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDb": "mongodb://mongodb:27017"
  },
  "Ollama": {
    "Endpoint": "http://ollama:11434",
    "Model": "llama3.2",
    "EmbeddingModel": "nomic-embed-text"
  },
  "DocumentSettings": {
    "ScanPaths": [
      "/app/documents"
    ],
    "ScanIntervalMinutes": 5,
    "ExcludePatterns": [
      "*.tmp",
      "*.bak",
      "*.temp",
      "backup",
      "temp"
    ],
    "EnableFileSystemWatcher": true,
    "PollingIntervalSeconds": 30
  }
}
